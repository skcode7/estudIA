# Shared development configuration
# DB / API / Web
DATABASE_URL="postgresql://estudia:estudia@localhost:5432/estudia?schema=public"
API_PORT=3001
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# AI configuration (required only when the AI adapter is implemented)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_QUESTIONS_PER_MATERIAL=3

# ObjectStorage (S3-compatible). MinIO for local development.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=estudia
S3_SECRET_KEY=estudia-secret
S3_BUCKET=estudia-materials
S3_FORCE_PATH_STYLE=true
