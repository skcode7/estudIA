# Shared development configuration
# DB / API / Web
DATABASE_URL="postgresql://estudia:estudia@localhost:5432/estudia?schema=public"
API_PORT=3001
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# AI configuration
# Proveedor general de IA. El default del código es "deepseek"; para usar
# OpenRouter como proveedor de extracción, setear AI_PROVIDER=openrouter.
AI_PROVIDER=openrouter

# OpenRouter: proveedor general de extracción de información.
# OPENROUTER_MODEL=openrouter/auto deja que el router elija modelo por prompt
# (soporta JSON estricto y entradas con imágenes).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Attribution en OpenRouter (https://openrouter.ai/docs/app-attribution).
# Si OPENROUTER_APP_URL está vacío no se envían headers y la app no aparece
# en rankings ni en el marketplace. Categorías: slugs del marketplace,
# separadas por coma (máx. 2), p. ej. "game" (grupo Entertainment).
OPENROUTER_APP_URL=https://estudia.kids/
OPENROUTER_APP_TITLE=estudIA
OPENROUTER_APP_CATEGORIES=game

# Alternativa: DeepSeek (default del código)
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

AI_QUESTIONS_PER_MATERIAL=3

# Modelo especialista (fijo, no openrouter/auto) para extraer figuras
# embebidas (banderas, mapas, diagramas) de fotos de apuntes.
# Requiere OPENROUTER_API_KEY; si falta, la extracción se omite y el material
# se procesa solo con preguntas de texto.
IMAGE_EXTRACTION_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# ObjectStorage (S3-compatible). MinIO for local development.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=estudia
S3_SECRET_KEY=estudia-secret
S3_BUCKET=estudia-materials
S3_FORCE_PATH_STYLE=true

# Authentico IAM (login). Base = raíz de la app, sin SecurityService/MenuService.
# Dev en WSL: http://172.31.48.1/AuthenticoNetPg (gateway WSL→host Windows;
#             `ip route show default`; localhost NO llega al host Windows).
# API en contenedor: http://host.docker.internal/AuthenticoNetPg
# Producción (Coolify): URL pública del Authentico desplegado.
AUTHENTICO_BASE_URL=http://172.31.48.1/AuthenticoNetPg
AUTHENTICO_APPLICATION=estudIA
AUTHENTICO_ACCOUNT=fa57e5b6-9876-0193-9fc7-f44e0d702062
AUTHENTICO_TIMEOUT_MS=10000
